# ── Variáveis de ambiente do backend de e-mail (Resend) ──
# Copie para um arquivo .env LOCAL (que NÃO é commitado) e/ou configure
# as mesmas chaves no painel da Vercel: Settings > Environment Variables.
#
# NUNCA commitar a chave real. Este arquivo é só um modelo.

# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Para onde os e-mails do formulário vão. Padrão no código:
# aios.chatbot@gmail.com
CONTACT_TO=aios.chatbot@gmail.com

# (Opcional) Remetente. Enquanto o domínio não estiver verificado em
# resend.com/domains, use onboarding@resend.dev. Depois de verificar,
# troque por algo como "Phytonatus <contato@phytonatus.com.br>".
CONTACT_FROM=Site Phytonatus <onboarding@resend.dev>

# ── GA4 / Analytics ──────────────────────────────────────────
# IDs públicos (já embarcados no HTML). Os valores REAIS de produção e a
# conta de serviço ficam FORA do repo, em: ~/.secrets/phytonatus-ga4.env
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_PROPERTY_ID=000000000
GA4_DATA_STREAM_ID=0000000000

# Conta de serviço Google (MCP analytics-mcp + Admin API). A chave PRIVADA é
# um .json guardado fora do repo; aqui só o caminho.
GCP_PROJECT_ID=seu-projeto-gcp
GA4_SA_EMAIL=conta-servico@seu-projeto.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/sua-chave.json
